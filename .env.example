GROQ_API_KEY=
# Opcional: si se configura, Claude Sonnet se usa como proveedor principal
# (Groq queda de respaldo automatico si Claude falla).
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Opcionales (tienen default seguro si se dejan vacios):
# Dominios del frontend separados por coma. Sin esto, solo se permite
# localhost:5173/127.0.0.1:5173 (desarrollo). En produccion, poner el
# dominio real de Cloudflare Pages.
CORS_ORIGINS=
# Mensajes gratis por dia para invitados (respaldo del lado del servidor).
GUEST_MESSAGE_LIMIT=10
